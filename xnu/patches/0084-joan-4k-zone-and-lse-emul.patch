From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: joan <joan@local>
Date: Wed, 18 Nov 2026 21:46:00 +0900
Subject: [PATCH] joan: 4KB 24GB ZONE_MAP_VA_SIZE and ARMv8.1-A LSE emulator in sleh.c

diff --git a/osfmk/kern/zalloc.c b/osfmk/kern/zalloc.c
--- a/osfmk/kern/zalloc.c
+++ b/osfmk/kern/zalloc.c
@@ -160,7 +160,7 @@
 #define ZONE_GUARD_SPARSE       (64  * 1024)
 #endif /* ZSECURITY_CONFIG(SAD_FENG_SHUI) */
 
-#if XNU_PLATFORM_MacOSX
+#if XNU_PLATFORM_MacOSX && defined(ARM_LARGE_MEMORY)
 #define ZONE_MAP_MAX            (32ULL << 30)
 #define ZONE_MAP_VA_SIZE        (128ULL << 30)
 #else /* XNU_PLATFORM_MacOSX */
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -878,6 +878,232 @@
  * Uncategorized exceptions are a catch-all for general execution errors.
  * ARM64_TODO: For now, we assume this is for undefined instruction exceptions.
  */
+#if defined(SWEET)
+static uint64_t
+sweet_lse_get_reg(const arm_saved_state64_t *ss, uint32_t r, bool is_base)
+{
+	if (r < 29U) {
+		return ss->x[r];
+	}
+	if (r == 29U) {
+		return ss->fp;
+	}
+	if (r == 30U) {
+		return ss->lr;
+	}
+	return is_base ? ss->sp : 0ULL;
+}
+
+static void
+sweet_lse_set_reg(arm_saved_state64_t *ss, uint32_t r, uint64_t val)
+{
+	if (r < 29U) {
+		ss->x[r] = val;
+	} else if (r == 29U) {
+		ss->fp = val;
+	} else if (r == 30U) {
+		ss->lr = val;
+	}
+}
+
+static int64_t
+sweet_lse_sext(uint64_t val, uint32_t nbytes)
+{
+	switch (nbytes) {
+	case 1U: return (int64_t)(int8_t)(uint8_t)val;
+	case 2U: return (int64_t)(int16_t)(uint16_t)val;
+	case 4U: return (int64_t)(int32_t)(uint32_t)val;
+	default: return (int64_t)val;
+	}
+}
+
+static int
+sweet_lse_mem_read(arm_saved_state_t *state, uint64_t addr, void *dst, size_t len)
+{
+	if (PSR64_IS_KERNEL(get_saved_state_cpsr(state))) {
+		return copyin_kern((user_addr_t)addr, (char *)dst, (vm_size_t)len);
+	}
+	return copyin((user_addr_t)addr, dst, len);
+}
+
+static int
+sweet_lse_mem_write(arm_saved_state_t *state, uint64_t addr, const void *src, size_t len)
+{
+	if (PSR64_IS_KERNEL(get_saved_state_cpsr(state))) {
+		return copyout_kern((const char *)src, (user_addr_t)addr, (vm_size_t)len);
+	}
+	return copyout(src, (user_addr_t)addr, len);
+}
+
+static bool
+sweet_emulate_armv81_lse(arm_saved_state_t *state, uint32_t instr)
+{
+	arm_saved_state64_t *ss = saved_state64(state);
+	bool is_kern = PSR64_IS_KERNEL(get_saved_state_cpsr(state));
+
+	/* LDADD / LDCLR / LDEOR / LDSET / LDSMAX / LDSMIN / LDUMAX / LDUMIN / SWP / ST* */
+	if ((instr & 0x3f200c00U) == 0x38200000U) {
+		uint32_t o3 = (instr >> 15) & 1U;
+		uint32_t opc = (instr >> 12) & 7U;
+		if (o3 == 1U && opc != 0U) {
+			return false;
+		}
+		uint32_t sz = (instr >> 30) & 3U;
+		uint32_t nbytes = 1U << sz;
+		uint64_t mask = (nbytes == 8U) ? ~0ULL : ((1ULL << (nbytes * 8U)) - 1ULL);
+		uint32_t rs = (instr >> 16) & 31U;
+		uint32_t rn = (instr >> 5) & 31U;
+		uint32_t rt = instr & 31U;
+		uint64_t addr = sweet_lse_get_reg(ss, rn, true);
+		uint64_t rs_val = sweet_lse_get_reg(ss, rs, false) & mask;
+		uint64_t old_val = 0, new_val = 0;
+		boolean_t intr = FALSE;
+		if (is_kern) {
+			intr = ml_set_interrupts_enabled(FALSE);
+		}
+		__sync_synchronize();
+		if (sweet_lse_mem_read(state, addr, &old_val, nbytes) != 0) {
+			if (is_kern) { ml_set_interrupts_enabled(intr); }
+			return false;
+		}
+		old_val &= mask;
+		if (o3 == 1U) {
+			new_val = rs_val;
+		} else {
+			switch (opc) {
+			case 0U: new_val = old_val + rs_val; break;
+			case 1U: new_val = old_val & ~rs_val; break;
+			case 2U: new_val = old_val ^ rs_val; break;
+			case 3U: new_val = old_val | rs_val; break;
+			case 4U: new_val = (sweet_lse_sext(old_val, nbytes) > sweet_lse_sext(rs_val, nbytes)) ? old_val : rs_val; break;
+			case 5U: new_val = (sweet_lse_sext(old_val, nbytes) < sweet_lse_sext(rs_val, nbytes)) ? old_val : rs_val; break;
+			case 6U: new_val = (old_val > rs_val) ? old_val : rs_val; break;
+			default: new_val = (old_val < rs_val) ? old_val : rs_val; break;
+			}
+		}
+		new_val &= mask;
+		if (sweet_lse_mem_write(state, addr, &new_val, nbytes) != 0) {
+			if (is_kern) { ml_set_interrupts_enabled(intr); }
+			return false;
+		}
+		__sync_synchronize();
+		if (is_kern) {
+			ml_set_interrupts_enabled(intr);
+		}
+		sweet_lse_set_reg(ss, rt, old_val);
+		add_saved_state_pc(state, 4);
+		return true;
+	}
+
+	/* CAS / CASA / CASL / CASAL / CASB / CASH */
+	if ((instr & 0x3fa07c00U) == 0x08a07c00U) {
+		uint32_t sz = (instr >> 30) & 3U;
+		uint32_t nbytes = 1U << sz;
+		uint64_t mask = (nbytes == 8U) ? ~0ULL : ((1ULL << (nbytes * 8U)) - 1ULL);
+		uint32_t rs = (instr >> 16) & 31U;
+		uint32_t rn = (instr >> 5) & 31U;
+		uint32_t rt = instr & 31U;
+		uint64_t addr = sweet_lse_get_reg(ss, rn, true);
+		uint64_t cmp_val = sweet_lse_get_reg(ss, rs, false) & mask;
+		uint64_t new_val = sweet_lse_get_reg(ss, rt, false) & mask;
+		uint64_t old_val = 0;
+		boolean_t intr = FALSE;
+		if (is_kern) {
+			intr = ml_set_interrupts_enabled(FALSE);
+		}
+		__sync_synchronize();
+		if (sweet_lse_mem_read(state, addr, &old_val, nbytes) != 0) {
+			if (is_kern) { ml_set_interrupts_enabled(intr); }
+			return false;
+		}
+		old_val &= mask;
+		if (old_val == cmp_val) {
+			if (sweet_lse_mem_write(state, addr, &new_val, nbytes) != 0) {
+				if (is_kern) { ml_set_interrupts_enabled(intr); }
+				return false;
+			}
+		}
+		__sync_synchronize();
+		if (is_kern) {
+			ml_set_interrupts_enabled(intr);
+		}
+		sweet_lse_set_reg(ss, rs, old_val);
+		add_saved_state_pc(state, 4);
+		return true;
+	}
+
+	/* CASP / CASPA / CASPL / CASPAL */
+	if ((instr & 0xbfa07c00U) == 0x08207c00U) {
+		uint32_t sz = (instr >> 30) & 1U;
+		uint32_t rs = (instr >> 16) & 31U;
+		uint32_t rn = (instr >> 5) & 31U;
+		uint32_t rt = instr & 31U;
+		if ((rs & 1U) != 0U || (rt & 1U) != 0U) {
+			return false;
+		}
+		uint64_t addr = sweet_lse_get_reg(ss, rn, true);
+		boolean_t intr = FALSE;
+		if (is_kern) {
+			intr = ml_set_interrupts_enabled(FALSE);
+		}
+		__sync_synchronize();
+		if (sz == 0U) {
+			uint32_t oldp[2] = {0, 0};
+			uint32_t cmpp[2] = {
+				(uint32_t)sweet_lse_get_reg(ss, rs, false),
+				(uint32_t)sweet_lse_get_reg(ss, rs + 1U, false)
+			};
+			uint32_t newp[2] = {
+				(uint32_t)sweet_lse_get_reg(ss, rt, false),
+				(uint32_t)sweet_lse_get_reg(ss, rt + 1U, false)
+			};
+			if (sweet_lse_mem_read(state, addr, oldp, sizeof(oldp)) != 0) {
+				if (is_kern) { ml_set_interrupts_enabled(intr); }
+				return false;
+			}
+			if (oldp[0] == cmpp[0] && oldp[1] == cmpp[1]) {
+				if (sweet_lse_mem_write(state, addr, newp, sizeof(newp)) != 0) {
+					if (is_kern) { ml_set_interrupts_enabled(intr); }
+					return false;
+				}
+			}
+			__sync_synchronize();
+			if (is_kern) { ml_set_interrupts_enabled(intr); }
+			sweet_lse_set_reg(ss, rs, (uint64_t)oldp[0]);
+			sweet_lse_set_reg(ss, rs + 1U, (uint64_t)oldp[1]);
+		} else {
+			uint64_t oldp[2] = {0, 0};
+			uint64_t cmpp[2] = {
+				sweet_lse_get_reg(ss, rs, false),
+				sweet_lse_get_reg(ss, rs + 1U, false)
+			};
+			uint64_t newp[2] = {
+				sweet_lse_get_reg(ss, rt, false),
+				sweet_lse_get_reg(ss, rt + 1U, false)
+			};
+			if (sweet_lse_mem_read(state, addr, oldp, sizeof(oldp)) != 0) {
+				if (is_kern) { ml_set_interrupts_enabled(intr); }
+				return false;
+			}
+			if (oldp[0] == cmpp[0] && oldp[1] == cmpp[1]) {
+				if (sweet_lse_mem_write(state, addr, newp, sizeof(newp)) != 0) {
+					if (is_kern) { ml_set_interrupts_enabled(intr); }
+					return false;
+				}
+			}
+			__sync_synchronize();
+			if (is_kern) { ml_set_interrupts_enabled(intr); }
+			sweet_lse_set_reg(ss, rs, oldp[0]);
+			sweet_lse_set_reg(ss, rs + 1U, oldp[1]);
+		}
+		add_saved_state_pc(state, 4);
+		return true;
+	}
+
+	return false;
+}
+#endif /* defined(SWEET) */
+
 static void
 handle_uncategorized(arm_saved_state_t *state)
 {
@@ -887,6 +1113,12 @@
 	uint32_t                   instr     = 0;
 
 	COPYIN(get_saved_state_pc(state), (char *)&instr, sizeof(instr));
+
+#if defined(SWEET)
+	if (is_saved_state64(state) && sweet_emulate_armv81_lse(state, instr)) {
+		return;
+	}
+#endif
 
 #if CONFIG_DTRACE
 
