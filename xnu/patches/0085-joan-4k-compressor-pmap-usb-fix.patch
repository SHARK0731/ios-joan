From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: joan <joan@local>
Date: Wed, 18 Nov 2026 23:16:00 +0900
Subject: [PATCH] joan: 4KB compressor VA limit, contiguous kernel_map reserve, safe USB default

diff --git a/osfmk/vm/vm_compressor.c b/osfmk/vm/vm_compressor.c
--- a/osfmk/vm/vm_compressor.c
+++ b/osfmk/vm/vm_compressor.c
@@ -811,7 +811,7 @@
 	compressor_pool_max_size = C_SEG_MAX_LIMIT;
 	compressor_pool_max_size *= c_seg_bufsize;
 
-#if XNU_TARGET_OS_OSX
+#if XNU_TARGET_OS_OSX && defined(ARM_LARGE_MEMORY)
 
 	if (vm_compression_limit == 0) {
 		if (max_mem <= (4ULL * 1024ULL * 1024ULL * 1024ULL)) {
diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -2539,7 +2539,14 @@
 
 	if (((gVirtBase & low_global_vr_mask) != LOW_GLOBAL_BASE_ADDRESS) && (region_select == 2)) {
 		*startp = LOW_GLOBAL_BASE_ADDRESS;
+#if defined(SWEET)
+		/* Reserve everything from LOW_GLOBAL_BASE_ADDRESS up to gVirtBase
+		 * so the 16MB 4KB early framebuffer alias (+2MB..+18MB) never collides
+		 * with kernel_map and kmem_scramble_ranges sees one contiguous free hole. */
+		*size = (gVirtBase & low_global_vr_mask) - LOW_GLOBAL_BASE_ADDRESS;
+#else
 		*size = low_global_vr_size;
+#endif
 		ret = TRUE;
 	}
 
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -76,7 +76,7 @@
 void
 sweet_usb_probe(void)
 {
-	int enabled = 1;
+	int enabled = 0;
 	uint32_t gdscr, cbcr[sizeof(usb_cbcr) / sizeof(usb_cbcr[0])];
 	bool clocks_on = true;
 
